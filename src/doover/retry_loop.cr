module Doover
  # Internal macro that expands the retry loop inline.
  #
  # Both `Runner#run` and the method wrappers generated by `do_over` use this
  # macro. Expanding the loop inline lets wrappers call `previous_def` directly,
  # which is required for methods with default arguments.
  macro __doover_retry(config)
    __doover_config = {{config}}
    __doover_attempt = 1
    __doover_skip_delay = __doover_config.zero_delay?

    loop do
      begin
        return {{yield}}
      rescue __doover_error : Exception
        if __doover_attempt >= __doover_config.attempts
          __doover_config.exhausted_handlers.each do |__doover_handler|
            __doover_handler.call(__doover_error, __doover_attempt)
          end

          raise __doover_error
        end

        __doover_aborted = false
        __doover_config.retry_handlers.each do |__doover_handler|
          unless __doover_handler.call(__doover_error, __doover_attempt)
            __doover_aborted = true
            break
          end
        end

        raise __doover_error if __doover_aborted

        unless __doover_skip_delay
          __doover_wait = __doover_config.delay_for(__doover_attempt)
          __doover_config.sleeper.call(__doover_wait) if __doover_wait > Time::Span.zero
        end

        __doover_attempt += 1
      end
    end
  end
end
